{
  "name": "atlas",
  "productName": "Atlas",
  "version": "0.1.0-beta",
  "private": true,
  "repository": "https://github.com/AnshX01/Atlas",
  "author": "AnshX01",
  "description": "Atlas",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "electron-compile": "npx tsup electron/main.ts electron/preload.ts --outDir dist-electron --format cjs --external electron --external sql.js",
    "electron-dev": "concurrently \"npm run dev -- --port 3000\" \"wait-on http://localhost:3000 && npm run electron-compile && electron dist-electron/main.js\"",
    "electron-build": "next build && npm run electron-compile && electron-builder build",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@modelcontextprotocol/server-github": "^2025.4.8",
    "@modelcontextprotocol/server-slack": "^2025.4.25",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-query": "^5.40.0",
    "axios": "^1.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "electron-serve": "^3.0.1",
    "framer-motion": "^11.2.0",
    "lucide-react": "^0.390.0",
    "next": "^16.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^2.3.0",
    "typescript": "^5.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11",
    "wait-on": "^7.2.0"
  }
}
