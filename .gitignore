# ============================================================
# Atlas — .gitignore
# ============================================================

# ── Secrets & Environment ────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
pip-wheel-metadata/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml
*.cover

# ── Node / Next.js / Electron ────────────────────────────────
node_modules/
.next/
out/
dist-electron/
release/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Docker ───────────────────────────────────────────────────
*.log

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.iml

# ── Alembic ──────────────────────────────────────────────────
# (keep versions tracked, ignore pycache inside)
backend/alembic/__pycache__/

# ── Local DB / Dev Data ──────────────────────────────────────
postgres_data/
neo4j_data/
qdrant_data/
redis_data/
