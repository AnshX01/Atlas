# ============================================================
# Atlas — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING_HERE
APP_MASTER_ENCRYPTION_KEY=CHANGE_ME_AES256_BASE64_KEY_HERE

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlas
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://atlas_user:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/atlas

# ── Neo4j ────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── AI Providers ─────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Local-first mode (routes all AI through Ollama)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/google/callback
GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar.readonly

# ── GitHub OAuth ─────────────────────────────────────────────
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/github/callback
GITHUB_WEBHOOK_SECRET=CHANGE_ME

# ── Local File System ────────────────────────────────────────
LOCAL_FS_WATCH_PATHS=/Users/you/Documents,/Users/you/Desktop
LOCAL_FS_IGNORE_PATTERNS=node_modules,.git,*.pyc

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Observability ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=atlas-backend
LOG_LEVEL=INFO
